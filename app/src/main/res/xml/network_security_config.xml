<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Android network security configuration cannot enumerate user-entered local
      origins at runtime. Keep the platform allowance so loopback, emulator, and
      explicitly approved private-network MCP endpoints can work. McpEndpointPolicy
      remains the per-origin trust decision for settings, requests, and redirects.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
